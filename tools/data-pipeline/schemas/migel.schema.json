{
  "$id": "heor-skills/data/ch/migel",
  "description": "Swiss MiGeL normalized data. $defs.index validates index.json (language-independent structure); $defs.labels validates <lang>.json label files.",
  "$defs": {
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["list", "jurisdiction", "version", "currency", "languages", "source", "hierarchy", "entries"],
      "properties": {
        "list": { "const": "migel" },
        "jurisdiction": { "const": "ch" },
        "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "currency": { "const": "CHF" },
        "languages": { "type": "array", "minItems": 1, "items": { "enum": ["de", "fr", "it"] } },
        "source": {
          "type": "object",
          "required": ["file", "landingUrl"],
          "properties": {
            "file": { "type": "string" },
            "landingUrl": { "type": "string" }
          }
        },
        "hierarchy": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "level", "parent"],
            "properties": {
              "id": { "type": "string", "minLength": 2 },
              "level": { "type": "integer", "minimum": 1, "maximum": 7 },
              "parent": { "type": ["string", "null"] }
            }
          }
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "parent", "limitationFlag", "prices", "validFrom"],
            "properties": {
              "code": { "type": "string", "pattern": "^\\d{2}\\.\\d{2}\\.\\d{2}\\.\\d{2}\\.\\d$" },
              "parent": { "type": ["string", "null"] },
              "limitationFlag": { "type": "boolean" },
              "prices": {
                "type": "object",
                "additionalProperties": false,
                "required": ["selfApplication", "care"],
                "properties": {
                  "selfApplication": { "type": ["number", "null"], "minimum": 0 },
                  "care": { "type": ["number", "null"], "minimum": 0 }
                }
              },
              "validFrom": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["list", "jurisdiction", "version", "language", "hierarchy", "entries"],
      "properties": {
        "list": { "const": "migel" },
        "jurisdiction": { "const": "ch" },
        "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "language": { "enum": ["de", "fr", "it"] },
        "hierarchy": {
          "type": "object",
          "patternProperties": {
            "^.+$": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "note"],
              "properties": {
                "name": { "type": "string" },
                "note": { "type": ["string", "null"] }
              }
            }
          }
        },
        "entries": {
          "type": "object",
          "patternProperties": {
            "^\\d{2}\\.\\d{2}\\.\\d{2}\\.\\d{2}\\.\\d$": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "limitation", "unit"],
              "properties": {
                "name": { "type": "string" },
                "limitation": { "type": ["string", "null"] },
                "unit": { "type": ["string", "null"] }
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
