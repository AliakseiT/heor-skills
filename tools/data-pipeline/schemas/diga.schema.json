{
  "$id": "heor-skills/data/de/diga",
  "description": "Planned shape for the German DiGA directory (normalizer not yet implemented — see normalizers/de-diga.ts).",
  "$defs": {
    "index": {
      "type": "object",
      "required": ["list", "jurisdiction", "version", "currency", "languages", "source", "entries"],
      "properties": {
        "list": { "const": "diga" },
        "jurisdiction": { "const": "de" },
        "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "currency": { "const": "EUR" },
        "languages": { "type": "array", "items": { "const": "de" } },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "status"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "status": { "enum": ["active", "provisional", "deleted"] },
              "prices": {
                "type": "object",
                "properties": { "manufacturerPrice": { "type": ["number", "null"], "minimum": 0 } }
              },
              "icdCodes": { "type": "array", "items": { "type": "string" } },
              "validFrom": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "required": ["list", "jurisdiction", "version", "language", "entries"],
      "properties": {
        "list": { "const": "diga" },
        "language": { "const": "de" },
        "entries": {
          "type": "object",
          "patternProperties": {
            "^.+$": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "description": { "type": ["string", "null"] },
                "manufacturer": { "type": ["string", "null"] },
                "indication": { "type": ["string", "null"] },
                "url": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
