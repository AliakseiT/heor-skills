{
  "$id": "heor-skills/data/de/diga",
  "description": "German DiGA directory (see normalizers/de-diga.ts). status follows FHIR CatalogEntry (observed: active, retired). prices is the list of prescription-unit price components (publisher-price etc.), each with PZN and unit title where available.",
  "$defs": {
    "index": {
      "type": "object",
      "required": ["list", "jurisdiction", "version", "currency", "languages", "source", "entries"],
      "properties": {
        "list": { "const": "diga" },
        "jurisdiction": { "const": "de" },
        "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "currency": { "const": "EUR" },
        "languages": { "type": "array", "items": { "const": "de" } },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "status"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "status": { "enum": ["draft", "active", "retired", "unknown"] },
              "prices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "amount", "currency"],
                  "properties": {
                    "type": { "type": "string" },
                    "amount": { "type": "number", "minimum": 0 },
                    "currency": { "type": "string" },
                    "unit": { "type": "string" },
                    "pzn": { "type": "string" }
                  }
                }
              },
              "icdCodes": { "type": "array", "items": { "type": "string" } },
              "validFrom": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "required": ["list", "jurisdiction", "version", "language", "entries"],
      "properties": {
        "list": { "const": "diga" },
        "language": { "const": "de" },
        "entries": {
          "type": "object",
          "patternProperties": {
            "^.+$": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "description": { "type": ["string", "null"] },
                "manufacturer": { "type": ["string", "null"] },
                "indication": { "type": ["string", "null"] },
                "url": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
