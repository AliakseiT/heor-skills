{
  "$id": "heor-skills/data/fr/lpp",
  "description": "French Liste des Produits et Prestations (LPP) from CNAM / ameli. DBF tables parsed with the built-in pure-TS reader.",
  "$defs": {
    "index": {
      "type": "object",
      "required": ["list", "jurisdiction", "version", "currency", "languages", "source", "entries"],
      "properties": {
        "list": { "const": "lpp" },
        "jurisdiction": { "const": "fr" },
        "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "currency": { "const": "EUR" },
        "languages": { "type": "array", "items": { "const": "fr" } },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "tariff"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "tariff": { "type": ["number", "null"], "minimum": 0 },
              "validUntil": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "required": ["list", "jurisdiction", "version", "language", "entries"],
      "properties": {
        "list": { "const": "lpp" },
        "language": { "const": "fr" },
        "entries": {
          "type": "object",
          "patternProperties": {
            "^.+$": {
              "type": "object",
              "required": ["name"],
              "properties": { "name": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
