{
  "$id": "heor-skills/data/us/hcpcs",
  "description": "US HCPCS Level II codes (see normalizers/us-hcpcs.ts). The quarterly ANWEB file also carries 2-character modifiers (category 'modifier'). Fee schedules are separate CMS datasets, so no prices here.",
  "$defs": {
    "index": {
      "type": "object",
      "required": ["list", "jurisdiction", "version", "languages", "source", "entries"],
      "properties": {
        "list": { "const": "hcpcs" },
        "jurisdiction": { "const": "us" },
        "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "languages": { "type": "array", "items": { "const": "en" } },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "category"],
            "properties": {
              "code": { "type": "string", "pattern": "^[A-Z0-9]{2,5}$" },
              "category": { "type": "string", "pattern": "^([A-Z]|modifier)$" },
              "addedDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "effectiveDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "terminationDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "coverageCode": { "type": "string" }
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "required": ["list", "jurisdiction", "version", "language", "entries"],
      "properties": {
        "list": { "const": "hcpcs" },
        "language": { "const": "en" },
        "entries": {
          "type": "object",
          "patternProperties": {
            "^[A-Z0-9]{2,5}$": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "shortName": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
