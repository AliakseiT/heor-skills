{
  "$id": "heor-skills/data/ch/analysenliste",
  "description": "Swiss Analysenliste normalized data. $defs.index validates index.json; $defs.labels validates <lang>.json label files.",
  "$defs": {
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["list", "jurisdiction", "version", "currency", "unit", "languages", "source", "entries"],
      "properties": {
        "list": { "const": "analysenliste" },
        "jurisdiction": { "const": "ch" },
        "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "currency": { "const": "CHF" },
        "unit": { "const": "tax-point" },
        "languages": { "type": "array", "minItems": 1, "items": { "enum": ["de", "fr", "it"] } },
        "source": {
          "type": "object",
          "required": ["file", "landingUrl"],
          "properties": {
            "file": { "type": "string" },
            "landingUrl": { "type": "string" }
          }
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "chapter", "taxPoints", "applicationsPerSample", "disciplines"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "chapter": { "type": "string" },
              "taxPoints": { "type": ["number", "null"], "minimum": 0 },
              "applicationsPerSample": { "type": ["number", "null"], "minimum": 0 },
              "disciplines": {
                "type": "object",
                "additionalProperties": false,
                "required": ["chemistry", "hematology", "immunology", "genetics"],
                "properties": {
                  "chemistry": { "type": "boolean" },
                  "hematology": { "type": "boolean" },
                  "immunology": { "type": "boolean" },
                  "genetics": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["list", "jurisdiction", "version", "language", "entries"],
      "properties": {
        "list": { "const": "analysenliste" },
        "jurisdiction": { "const": "ch" },
        "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "language": { "enum": ["de", "fr", "it"] },
        "entries": {
          "type": "object",
          "patternProperties": {
            "^.+$": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "method", "material", "result", "applicationsPerSample", "limitation", "remarks", "cumulation"],
              "properties": {
                "name": { "type": "string" },
                "method": { "type": ["string", "null"] },
                "material": { "type": ["string", "null"] },
                "result": { "type": ["string", "null"] },
                "applicationsPerSample": { "type": ["string", "null"] },
                "limitation": { "type": ["string", "null"] },
                "remarks": { "type": ["string", "null"] },
                "cumulation": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
